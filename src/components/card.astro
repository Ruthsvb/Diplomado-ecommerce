---
const { title, description, image, price } = Astro.props;
---

<article style="background:#f9fafb; border-radius:16px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.1); transition:transform 0.3s ease;">
  <!-- Imagen del producto sin recorte -->
  <div style="background:white; display:flex; align-items:center; justify-content:center; padding:1rem;">
    <img src={image} alt={title} class="zoom-img" style="max-width:100%; max-height:200px; object-fit:contain;" />
  </div>

  <!-- Contenido del producto -->
  <div style="padding:1rem;">
    <h3 style="color:#1e3a8a; font-size:1.2rem; margin:0 0 0.5rem;">{title}</h3>
    <p style="font-size:0.95rem; color:#374151; line-height:1.4;">{description}</p>
    <p style="font-weight:600; color:#111827; margin:0.75rem 0 0;">${price}</p>

    <button 
      class="add-to-cart" 
      data-product={JSON.stringify({ title, price })}
      style="margin-top:1rem; background:#4f46e5; color:white; padding:0.5rem 1rem; border:none; border-radius:8px; font-weight:600; cursor:pointer; transition:background 0.3s;"
      onmouseover="this.style.background='#4338ca'"
      onmouseout="this.style.background='#4f46e5'"
    >
      🛒 Agregar al carrito
    </button>
  </div>
</article>


