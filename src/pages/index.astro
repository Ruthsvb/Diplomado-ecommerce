---
import Card from '../components/card.astro';

let products = [];

try {
  const response = await fetch('https://dummyjson.com/products?limit=100');
  const data = await response.json();
  products = Array.isArray(data.products) ? data.products : [];
} catch (error) {
  console.error('Error al obtener productos:', error);
  products = [];
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tienda Glamour</title>
  </head>

  <body style="font-family: 'Segoe UI', sans-serif; margin: 0; padding: 0; background-color: #f0f2f5;">

    <!-- Encabezado -->
    <header style="display: flex; justify-content: space-between; align-items: center; background-color: #4f46e5; color: white; padding: 1rem;">
      <h1 style="margin: 0;">Tienda Glamour</h1>
      <div>Carrito: <span id="cart-count">0</span></div>
    </header>

    <!-- Hero -->
    <section style="padding: 4rem 1rem; background: linear-gradient(to right, #4f46e5, #6d28d9); color: white; text-align: center;">
      <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Bienvenidos a Tienda Glamour</h2>
      <p style="font-size: 1.2rem; max-width: 600px; margin: 0 auto;">
        Elegí entre productos únicos y modernos, pensados para destacar tu estilo.
      </p>
      <a href="#productos" style="margin-top: 2rem; display: inline-block; background: white; color: #4f46e5; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: bold; text-decoration: none;">
        Ver productos
      </a>
    </section>

    <!-- Buscador -->
    <section style="text-align: center; margin: 2rem 0;">
      <input 
        type="text" 
        id="search"
        placeholder="Buscar productos..."
        style="padding: 0.75rem; width: 80%; max-width: 400px; border: 1px solid #ccc; border-radius: 8px; font-size: 1rem;"
      />
    </section>

    <!-- Lista de productos -->
    <main id="productos" style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
      <div 
        id="product-list"
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;"
      >
        {
          products.length > 0 ? (
            products.map(product => (
              <Card 
                title={product.title}
                description={product.description}
                image={product.thumbnail}
                price={product.price}
              />
            ))
          ) : (
            <p style="text-align: center; color: #555;">No se encontraron productos.</p>
          )
        }
      </div>
    </main>

    <!-- Footer -->
    <footer style="text-align: center; padding: 2rem; background: #e5e7eb; color: #374151;">
      <p>&copy; 2025 Tienda Glamour. Todos los derechos reservados.</p>
    </footer>

    <!-- Scripts -->
    <script type="module">
      const input = document.getElementById('search');
      const list = document.getElementById('product-list');
      const cartCount = document.getElementById('cart-count');
      const cart = [];

      input.addEventListener('input', () => {
        const term = input.value.toLowerCase();
        Array.from(list.children).forEach(card => {
          const text = card.textContent.toLowerCase();
          card.style.display = text.includes(term) ? 'block' : 'none';
        });
      });

      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('add-to-cart')) {
          const product = JSON.parse(e.target.getAttribute('data-product'));
          cart.push(product);
          cartCount.textContent = cart.length;
        }
      });
    </script>
  </body>
</html>