---
// Estoy importando el componente que muestra cada tarjeta de producto
import Card from '../components/card.astro';

// Aquí creo una lista vacía donde voy a guardar los productos que traiga de la API
let products = [];

try {
  // Hago una solicitud a una API para obtener los productos
  const response = await fetch('https://dummyjson.com/products');
  const data = await response.json();

  // Verifico que los datos recibidos contengan una lista de productos antes de guardarlos
  products = Array.isArray(data.products) ? data.products : [];
} catch (error) {
  // Si algo falla en la petición, lo muestro en la consola y dejo la lista vacía
  console.error('Error al obtener productos:', error);
  products = [];
}
---


<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>La Tiendita</title>

    <!-- Fuente moderna para mejor diseño -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <!-- Estilos globales y animación para imágenes -->
    <style>
      body {
        font-family: 'Inter', sans-serif;
      }
      .zoom-img {
        transition: transform 0.3s ease;
      }
      .zoom-img:hover {
        transform: scale(1.1);
      }
    </style>
  </head>

  <body style="background:#0a0a0a; color:white; padding:2rem;">
    <!-- Título principal -->
    <h1 style="text-align:center; color:#4f46e5; font-size:3.5rem; margin-bottom:1rem;">🛍️ La Tiendita</h1>

    <!-- Descripción corta de la tienda con estilo bonito -->
    <p style="text-align:center; max-width:700px; margin:0 auto 2rem; color:#e0f2fe; font-size:1.15rem; background:rgba(255,255,255,0.05); padding:1rem 1.5rem; border-radius:12px; border-left:4px solid #4f46e5;">
      ✨ Bienvenido a <strong>La Tiendita</strong>, tu lugar para descubrir productos únicos y útiles, cuidadosamente seleccionados para ti. <br />
      
    </p>

    <!-- Buscador -->
    <section style="margin: 2rem auto; max-width: 600px;">
      <input 
        id="search"
        type="text"
        placeholder="🔍 Buscar productos..."
        style="width:100%; padding:1rem; border-radius:12px; border:none; box-shadow:0 2px 8px rgba(0,0,0,0.1); font-size:1rem;"
      />
    </section>

    <!-- Sección de productos -->
    <section style="max-width:1200px; margin:0 auto;">
      <h2 style="color:#fff; text-align:center;">Productos</h2>
      <div id="product-list" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:2rem; padding:2rem 0;">
        {products.map(product => (
          <Card 
            title={product.title} 
            description={product.description} 
            image={product.thumbnail} 
            price={product.price} 
          />
        ))}
      </div>
    </section>

    <!-- Panel flotante del carrito -->
    <div id="cart-panel" style="position:fixed; top:2rem; right:2rem; width:300px; background:#111; color:white; padding:1rem; border-radius:8px; border:1px solid #333; display:none; z-index:1000;"></div>

    <!-- Botón flotante para abrir/cerrar el carrito con posición fija restaurada -->
    <button id="cart-toggle" style="position:fixed; top:1rem; right:1rem; background:#4f46e5; color:white; border:none; border-radius:6px; padding:0.5rem 1rem; cursor:pointer; z-index:1001;">🛒 Ver Carrito (<span id="cart-count">0</span>)</button>

    <!-- Script para manejar búsqueda y carrito -->
    <script type="module">
      // Referencias a elementos del DOM
      const input = document.getElementById('search');
      const list = document.getElementById('product-list');
      const cartToggle = document.getElementById('cart-toggle');
      const cartPanel = document.getElementById('cart-panel');
      const cartCount = document.getElementById('cart-count');

      // Cargamos el carrito desde localStorage o inicializamos vacío
      let cart = JSON.parse(localStorage.getItem('cart')) || [];

      // Guardar carrito en localStorage
      function saveCart() {
        localStorage.setItem('cart', JSON.stringify(cart));
      }

      // Actualiza el panel del carrito visualmente
      function updateCart() {
        cartPanel.innerHTML = '<h3>Carrito</h3>';
        if (cart.length === 0) {
          cartPanel.innerHTML += '<p>El carrito está vacío.</p>';
        } else {
          let total = 0;
          cart.forEach((item, index) => {
            cartPanel.innerHTML += `<div style="margin-bottom:0.5rem;"><strong>${item.title}</strong> x${item.quantity} - $${item.price * item.quantity} <button data-index="${index}" class="remove-item" style="margin-left:0.5rem; background:red; color:white; border:none; border-radius:4px; cursor:pointer;">x</button></div>`;
            total += item.price * item.quantity;
          });
          cartPanel.innerHTML += `<hr/><p><strong>Total: $${total}</strong></p><button id="clear-cart" style="background:#ef4444; color:white; border:none; padding:0.5rem 1rem; border-radius:6px; cursor:pointer;">Vaciar</button>`;
        }
        cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0);
        saveCart();
      }

      // Alternar visibilidad del carrito
      cartToggle.onclick = () => {
        cartPanel.style.display = cartPanel.style.display === 'none' ? 'block' : 'none';
        updateCart();
      };

      // Delegamos clicks: agregar, eliminar o vaciar carrito
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('add-to-cart')) {
          const product = JSON.parse(e.target.dataset.product);
          const found = cart.find(p => p.title === product.title);
          if (found) {
            found.quantity++;
          } else {
            cart.push({ ...product, quantity: 1 });
          }
          updateCart();
        }
        if (e.target.classList.contains('remove-item')) {
          const index = parseInt(e.target.dataset.index);
          cart.splice(index, 1);
          updateCart();
        }
        if (e.target.id === 'clear-cart') {
          cart = [];
          updateCart();
        }
      });

      // Filtrar productos por texto ingresado
      input.addEventListener('input', () => {
        const term = input.value.toLowerCase();
        Array.from(list.children).forEach(card => {
          card.style.display = card.textContent.toLowerCase().includes(term) ? '' : 'none';
        });
      });

      // Inicializamos el panel del carrito
      updateCart();
    </script>
  </body>
</html>